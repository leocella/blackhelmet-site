{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/professores",
      "destination": "/#professor",
      "statusCode": 301
    },
    {
      "source": "/professores/",
      "destination": "/#professor",
      "statusCode": 301
    },
    {
      "source": "/contato",
      "destination": "/#agendar",
      "statusCode": 301
    },
    {
      "source": "/contato/",
      "destination": "/#agendar",
      "statusCode": 301
    },
    {
      "source": "/index",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:slug(a-trajetoria-de-mauricio-melo-.*)",
      "destination": "/trajetoria-mauricio-melo-jiu-jitsu-blumenau/",
      "statusCode": 301
    },
    {
      "source": "/:slug(a-trajetoria-de-mauricio-melo-.*)/",
      "destination": "/trajetoria-mauricio-melo-jiu-jitsu-blumenau/",
      "statusCode": 301
    },
    {
      "source": "/:slug(estrangulamento-norte.*)",
      "destination": "/estrangulamento-do-norte-sul-jiu-jitsu/",
      "statusCode": 301
    },
    {
      "source": "/:slug(estrangulamento-norte.*)/",
      "destination": "/estrangulamento-do-norte-sul-jiu-jitsu/",
      "statusCode": 301
    },
    {
      "source": "/:slug(mauricio-mello-recebe-6-grau-das-maos-crezio)",
      "destination": "/mauricio-melo-recebe-6-grau-das-maos-crezio/",
      "statusCode": 301
    },
    {
      "source": "/:slug(mauricio-mello-recebe-6-grau-das-maos-crezio)/",
      "destination": "/mauricio-melo-recebe-6-grau-das-maos-crezio/",
      "statusCode": 301
    },
    {
      "source": "/category/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/feed/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/feed",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:file(sitemap_index|wp-sitemap|post-sitemap|page-sitemap|category-sitemap).xml",
      "destination": "/sitemap.xml",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*).vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
